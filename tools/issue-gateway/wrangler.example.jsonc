{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yield-issue-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "REPLACE_WITH_NEW_YIELD_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "GITHUB_OWNER": "PORTALSURFER",
    "GITHUB_REPO": "yield",
    "GITHUB_OAUTH_SCOPE": "repo"
  }
}
