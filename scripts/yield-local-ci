if sys.version_info < (3, 11):
    for candidate in ("python3.13", "python3.12", "python3.11"):
        interpreter = shutil.which(candidate)
        if interpreter:
            probe = subprocess.run(
                [interpreter, "-c", "import sys; raise SystemExit(sys.version_info < (3, 11))"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if probe.returncode == 0:
                os.environ["YIELD_CI_PYTHON"] = interpreter
                os.execv(interpreter, [interpreter, str(pathlib.Path(__file__).resolve()), *sys.argv[1:]])
    raise SystemExit(
        "Yield local CI requires Python 3.11 or newer; install python3.11+ and ensure it is on PATH"
    )

os.environ.setdefault("YIELD_CI_PYTHON", sys.executable)
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "internal" / "ci"))
from runtime_paths import canonicalize_tmpdir

try:
    canonicalize_tmpdir()
except RuntimeError as error:
    raise SystemExit(str(error)) from error
_python_alias_dir = pathlib.Path(tempfile.mkdtemp(prefix="yield-python-"))
os.chmod(_python_alias_dir, 0o700)
(_python_alias_dir / "python3").symlink_to(pathlib.Path(sys.executable).resolve())
os.environ["PATH"] = str(_python_alias_dir) + os.pathsep + os.environ.get("PATH", "")
if subprocess.run(["python3", "-c", "import tomllib"], check=False).returncode != 0:
    raise SystemExit("selected Python runtime cannot import tomllib in a python3 child process")
atexit.register(shutil.rmtree, _python_alias_dir)

SCRIPT = pathlib.Path(__file__).resolve()
ROOT = SCRIPT.parent.parent
_packager_spec = importlib.util.spec_from_file_location(
    "yield_bundle_packager", ROOT / "scripts/package-gpui-macos.py"
)
if _packager_spec is None or _packager_spec.loader is None:
    raise SystemExit("cannot load the shared macOS bundle packager")
_packager = importlib.util.module_from_spec(_packager_spec)
_packager_spec.loader.exec_module(_packager)
sys.path.insert(0, str(ROOT / "scripts" / "internal" / "ci"))
import local_state  # noqa: E402
from process_tree import (  # noqa: E402
    Cancelled,
    GroupCleanupUnconfirmed,
    catch_cancellation_signals,
    group_exists,
    ignore_cancellation_signals,
    terminate_owned_group,
)

COORDINATOR_FD: Optional[int] = None
FROZEN_PREFLIGHT_BRANCH = "codex/local-ci-frozen-preflight"
FROZEN_PREFLIGHT_SLOT = "frozen-preflight"
NATIVE_EVIDENCE_OUTPUT = "YIELD_NATIVE_VERIFICATION_OUTPUT"
ADMISSION_MARKER = b"YIELD_ADMISSION_PROTOCOL_V1"
# A full check can contain the runner's 40-second nested-validator cleanup.
MANAGED_COMMAND_TERMINATION_GRACE_SECONDS = (40.0, 10.0, 5.0)


class CiError(RuntimeError):
    pass


def command_output(
    *args: str,
    cwd: pathlib.Path = ROOT,
    required: bool = True,
    log: Optional[TextIO] = None,
    combined_output: bool = False,
) -> str:
    if log is not None:
        log.write("$ " + " ".join(args) + "\n")
        log.flush()
    try:
        result = subprocess.run(args, cwd=str(cwd), text=True, capture_output=True, check=False)
    except OSError as exc:
        if log is not None:
            log.write(f"command start failed: {exc}\n")
            log.flush()
        if required:
            raise CiError(f"command failed: {' '.join(args)}: {exc}") from exc
        return "unavailable"
    if log is not None:
        if result.stdout:
            log.write(result.stdout)
        if result.stderr:
            log.write("[stderr]\n" + result.stderr)
        log.write(f"[exit {result.returncode}]\n")
        log.flush()
    if result.returncode:
        exc = subprocess.CalledProcessError(
            result.returncode, args, output=result.stdout, stderr=result.stderr
        )
        if required:
            raise CiError(f"command failed: {' '.join(args)}: {exc}") from exc
        return "unavailable"
    output = result.stdout + result.stderr if combined_output else result.stdout
    return output.strip()


def write_build_record(path: pathlib.Path, record: dict[str, object]) -> None:
    """Durably replace the run record without risking a stale fixed temp file."""
    fd, temporary = tempfile.mkstemp(prefix=".result-", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(json.dumps(record, indent=2) + "\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def run_managed(
    command: list[str],
    *,
    cwd: pathlib.Path,
    env: dict[str, str],
    pass_fds: tuple[int, ...] = (),
    stdout: object = None,
    timeout_seconds: int = 6 * 60 * 60,
    preserve_ignored_on_exit: bool = False,
) -> int:
    with catch_cancellation_signals(
        defer_startup=True, preserve_ignored_on_exit=preserve_ignored_on_exit
    ) as activate_cancellation:
        process = None
        try:
            process = subprocess.Popen(
                command,
                cwd=str(cwd),
                env=env,
                stdout=stdout,
                stderr=subprocess.STDOUT if stdout is not None else None,
                pass_fds=pass_fds,
                start_new_session=True,
            )
            activate_cancellation()
            status = process.wait(timeout=timeout_seconds)
            if group_exists(process.pid):
                ignore_cancellation_signals()
                if not terminate_owned_group(
                    process.pid,
                    process,
                    grace_seconds=MANAGED_COMMAND_TERMINATION_GRACE_SECONDS,
                ):
                    raise GroupCleanupUnconfirmed(
                        f"could not confirm exit of managed command process group {process.pid} after leader exit"
                    )
                return status or 1
            return status
        except Cancelled as cancelled:
            ignore_cancellation_signals()
            if process is None:
                if cancelled.signum == signal.SIGINT:
                    raise KeyboardInterrupt
                raise CiError(f"command cancelled by signal {cancelled.signum}: {' '.join(command)}")
            if not terminate_owned_group(
                process.pid,
                process,
                grace_seconds=MANAGED_COMMAND_TERMINATION_GRACE_SECONDS,
            ):
                raise GroupCleanupUnconfirmed(
                    f"could not confirm exit of managed command process group {process.pid}"
                )
            if cancelled.signum == signal.SIGINT:
                raise KeyboardInterrupt
            raise CiError(f"command cancelled by signal {cancelled.signum}: {' '.join(command)}")
        except subprocess.TimeoutExpired as exc:
            ignore_cancellation_signals()
            if not terminate_owned_group(
                process.pid,
                process,
                grace_seconds=MANAGED_COMMAND_TERMINATION_GRACE_SECONDS,
            ):
                raise GroupCleanupUnconfirmed(
                    f"could not confirm exit of timed-out command process group {process.pid}"
                ) from exc
            raise CiError(f"command exceeded the six-hour watchdog: {' '.join(command)}") from exc
        except GroupCleanupUnconfirmed:
            raise
        except BaseException:
            ignore_cancellation_signals()
            if process is None:
                raise
            if not terminate_owned_group(
                process.pid,
                process,
                grace_seconds=MANAGED_COMMAND_TERMINATION_GRACE_SECONDS,
            ):
                raise GroupCleanupUnconfirmed(
                    f"could not confirm exit of failed managed command process group {process.pid}"
                )
            raise


def source_sha(value: str) -> str:
    if len(value) != 40 or any(char not in "0123456789abcdef" for char in value):
        raise CiError("--sha must be a full lowercase 40-character commit")
    return value


def require_maintenance_protocol(checkout: pathlib.Path, *, full_lane: bool = False) -> None:
    main_source = (checkout / "crates/yield/src/main.rs").read_text(encoding="utf-8")
    app_dirs_source = (checkout / "crates/yield-library/src/app_dirs.rs").read_text(encoding="utf-8")
    if (
        "--build-info" not in main_source
        or "YIELD_ADMISSION_PROTOCOL_V1" not in main_source
        or "MAINTENANCE_ADMISSION_PROTOCOL_VERSION" not in app_dirs_source
    ):
        raise CiError("refusing a historical source SHA without pre-admission build-info and the maintenance protocol")
    if full_lane:
        full_script = checkout / "scripts/gpui-local-ci.sh"
        native_runner = checkout / "scripts/internal/ci/run_native_production_case.py"
        full_runner = checkout / "scripts/internal/ci/run_full_ci.py"
        runtime_helper = checkout / "scripts/internal/ci/python_runtime.sh"
        if not all(path.is_file() for path in (full_script, native_runner, full_runner, runtime_helper)):
            raise CiError("frozen source lacks the reversible full-CI or native production-case runner")


def binary_contains_marker(binary: pathlib.Path) -> bool:
    overlap = b""
    try:
        with binary.open("rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                data = overlap + chunk
                if ADMISSION_MARKER in data:
                    return True
                overlap = data[-(len(ADMISSION_MARKER) - 1) :]
    except OSError:
        return False
    return False


def compiled_build_info(binary: pathlib.Path) -> dict[str, object]:
    """Check for the inert v1 marker before executing any possible old binary."""
    if not binary_contains_marker(binary):
        raise CiError("refusing to execute a binary without the maintenance admission v1 marker")
    try:
        result = subprocess.run(
            [str(binary), "--build-info"], check=False, capture_output=True, text=True, timeout=5
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CiError("compiled binary did not answer its bounded pre-admission build-info probe") from exc
    if result.returncode != 0:
        raise CiError("compiled binary rejected its pre-admission build-info probe")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise CiError("compiled binary returned malformed pre-admission build-info") from exc
    if not isinstance(value, dict) or value.get("admission_marker") != ADMISSION_MARKER.decode("ascii"):
        raise CiError("compiled binary build-info does not confirm the maintenance admission marker")
    return value


@contextlib.contextmanager
def common_coordinator() -> Iterator[pathlib.Path]:
    global COORDINATOR_FD
    git_common = pathlib.Path(command_output("git", "rev-parse", "--path-format=absolute", "--git-common-dir"))
    state_dir = git_common / "local-ci"
    state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = state_dir / "active.lock"
    fd = os.open(
        lock_path,
        os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0),
        0o600,
    )
    try:
        metadata = os.fstat(fd)
        entry = lock_path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(entry.st_mode)
            or not stat.S_ISREG(entry.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1
            or (metadata.st_dev, metadata.st_ino) != (entry.st_dev, entry.st_ino)
        ):
            raise CiError("shared CI coordinator lock is not a regular current-user-owned file")
        fcntl.flock(fd, fcntl.LOCK_EX)
        COORDINATOR_FD = fd
        yield state_dir
    finally:
        COORDINATOR_FD = None
        os.close(fd)


@contextlib.contextmanager
def exact_worktree(sha: str) -> Iterator[pathlib.Path]:
    sha = source_sha(sha)
    if command_output("git", "cat-file", "-t", sha) != "commit":
        raise CiError("requested SHA is not an available commit")
    temporary = pathlib.Path(tempfile.mkdtemp(prefix="yield-local-ci-"))
    checkout = temporary / "checkout"
    branch = f"codex/local-ci-{uuid.uuid4().hex}"
    worktree_add_attempted = False
    branch_owned = False
    active_error: Optional[BaseException] = None
    try:
        worktree_add_attempted = True
        subprocess.run(
            ["git", "worktree", "add", "-b", branch, str(checkout), sha],
            cwd=str(ROOT),
            check=True,
        )
        branch_owned = True
        actual_sha = command_output("git", "rev-parse", "HEAD", cwd=checkout)
        actual_branch = command_output("git", "branch", "--show-current", cwd=checkout)
        if actual_sha != sha or actual_branch != branch:
            raise CiError("temporary source branch does not point at the requested exact commit")
        dirty = command_output("git", "status", "--porcelain", "--untracked-files=normal", cwd=checkout)
        if dirty:
            raise CiError("temporary exact-source worktree is unexpectedly dirty")
        yield checkout
    except BaseException as error:
        active_error = error
        raise
    finally:
        cleanup_errors: list[str] = []
        try:
            registrations = command_output("git", "worktree", "list", "--porcelain")
        except BaseException as error:
            registrations = None
            cleanup_errors.append(f"could not inspect registered worktrees: {error}")
        registered = registrations is None or any(
            line == f"worktree {checkout}" for line in registrations.splitlines()
        )
        if worktree_add_attempted and registered:
            try:
                removed = subprocess.run(
                    ["git", "worktree", "remove", "--force", str(checkout)],
                    cwd=str(ROOT),
                    capture_output=True,
                    text=True,
                    check=False,
                )
                if removed.returncode:
                    cleanup_errors.append(removed.stderr.strip() or "worktree removal failed")
            except BaseException as error:
                cleanup_errors.append(f"could not remove temporary worktree: {error}")
        try:
            registrations = command_output("git", "worktree", "list", "--porcelain")
            still_registered = any(line == f"worktree {checkout}" for line in registrations.splitlines())
        except BaseException as error:
            still_registered = True
            cleanup_errors.append(f"could not verify worktree removal: {error}")
        branch_ref = f"refs/heads/{branch}"
        try:
            branch_exists = subprocess.run(
                ["git", "show-ref", "--verify", "--quiet", branch_ref], cwd=str(ROOT), check=False
            ).returncode == 0
        except BaseException as error:
            branch_exists = False
            cleanup_errors.append(f"could not inspect temporary branch ref: {error}")
        if branch_exists and not branch_owned:
            cleanup_errors.append("branch creation was not confirmed; pre-existing or ambiguous ref was left intact")
        elif branch_exists and not still_registered:
            try:
                branch_sha = command_output("git", "rev-parse", branch_ref)
                if branch_sha != sha:
                    cleanup_errors.append("temporary branch ref changed; it was left intact")
                else:
                    removed = subprocess.run(
                        ["git", "branch", "-D", branch],
                        cwd=str(ROOT),
                        capture_output=True,
                        text=True,
                        check=False,
                    )
                    if removed.returncode:
                        cleanup_errors.append(removed.stderr.strip() or "temporary branch removal failed")
            except BaseException as error:
                cleanup_errors.append(f"could not safely remove temporary branch ref: {error}")
        if still_registered:
            cleanup_errors.append(f"worktree remains registered; preserved for recovery at {checkout}")
        else:
            try:
                if temporary.is_symlink():
                    raise OSError("temporary worktree parent became a symlink")
                shutil.rmtree(temporary)
            except OSError as error:
                cleanup_errors.append(f"could not remove temporary worktree directory {temporary}: {error}")
        if cleanup_errors:
            message = "; ".join(cleanup_errors)
            if active_error is not None:
                active_error.add_note(f"exact-source worktree cleanup issue: {message}")
            else:
                raise CiError(f"exact-source worktree cleanup failed: {message}")


def frozen_checkout_identity(checkout: pathlib.Path, sha: str) -> dict[str, object]:
    entry = checkout.lstat()
    if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != os.geteuid():
        raise CiError("frozen checkout is not a current-user-owned directory")
    git_file = (checkout / ".git").lstat()
    if not stat.S_ISREG(git_file.st_mode) or git_file.st_uid != os.geteuid():
        raise CiError("frozen checkout lacks its owned Git worktree pointer")
    return {"schema": 1, "sha": sha, "device": entry.st_dev, "inode": entry.st_ino}


def verify_frozen_checkout(state_dir: pathlib.Path, checkout: pathlib.Path, sha: str) -> None:
    if pathlib.Path(command_output("git", "rev-parse", "--show-toplevel", cwd=checkout)) != checkout:
        raise CiError("frozen Git worktree path does not match the checkout")
    git_common = pathlib.Path(command_output(
        "git", "rev-parse", "--path-format=absolute", "--git-common-dir", cwd=checkout
    ))
    if git_common != state_dir.parent:
        raise CiError("frozen checkout belongs to a different Git repository")
    branch = f"refs/heads/{FROZEN_PREFLIGHT_BRANCH}"
    registrations = command_output("git", "worktree", "list", "--porcelain", "-z", cwd=checkout)
    record = [f"worktree {checkout}", f"HEAD {sha}", f"branch {branch}"]
    if record not in [item.split("\0") for item in registrations.split("\0\0")]:
        raise CiError("frozen checkout does not have the expected worktree registration")
    if command_output("git", "rev-parse", "HEAD", cwd=checkout) != sha:
        raise CiError("frozen checkout is on a different commit")
    if command_output("git", "symbolic-ref", "HEAD", cwd=checkout) != branch:
        raise CiError("frozen checkout is on a different branch")
    files = command_output("git", "ls-files", "-v", "-z", cwd=checkout)
    if any(entry and not entry.startswith("H ") for entry in files.split("\0")):
        raise CiError("frozen checkout has hidden or nonstandard index entries")
    dirty = command_output(
        "git", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false",
        "status", "--porcelain=v1", "--untracked-files=all", "--ignored=matching", cwd=checkout,
    )
    if dirty:
        raise CiError("frozen checkout contains modified or extra files")


def prepare_frozen_preflight(sha: str, state_dir: pathlib.Path) -> tuple[pathlib.Path, str]:
    if COORDINATOR_FD is None:
        raise CiError("frozen checkout requires the repository coordinator")
    sha = source_sha(sha)
    if command_output("git", "cat-file", "-t", sha) != "commit":
        raise CiError("requested SHA is not an available commit")
    if state_dir.is_symlink() or state_dir.stat().st_uid != os.geteuid():
        raise CiError("frozen checkout requires an owned local-CI state directory")
    slot = state_dir / FROZEN_PREFLIGHT_SLOT
    checkout = slot / "checkout"
    owner = slot / "owner.json"
    try:
        slot.mkdir(mode=0o700)
    except FileExistsError:
        entry = slot.lstat()
        if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != os.geteuid() or entry.st_mode & 0o077:
            raise CiError("frozen checkout slot is not a private current-user-owned directory")
        if os.path.lexists(slot / "active"):
            raise CiError("frozen checkout has an unconfirmed previous process-group exit")
        marker = owner.lstat()
        if not stat.S_ISREG(marker.st_mode) or marker.st_uid != os.geteuid() or marker.st_size > 4096:
            raise CiError("frozen checkout ownership marker is invalid")
        try:
            identity = json.loads(owner.read_text(encoding="utf-8"))
        except (UnicodeError, ValueError) as error:
            raise CiError("frozen checkout ownership marker is unreadable") from error
        if not isinstance(identity, dict) or not isinstance(identity.get("sha"), str):
            raise CiError("frozen checkout ownership marker is malformed")
        previous = source_sha(identity["sha"])
        if identity != frozen_checkout_identity(checkout, previous):
            raise CiError("frozen checkout filesystem identity changed")
        verify_frozen_checkout(state_dir, checkout, previous)
        if sha == previous:
            return checkout, "reused"
        command_output(
            "git", "-c", "core.hooksPath=/dev/null", "switch", "--no-overwrite-ignore",
            "-C", FROZEN_PREFLIGHT_BRANCH, sha, cwd=checkout,
        )
        disposition = "updated"
    else:
        command_output(
            "git", "-c", "core.hooksPath=/dev/null", "worktree", "add",
            "-b", FROZEN_PREFLIGHT_BRANCH, str(checkout), sha,
        )
        disposition = "created"

    verify_frozen_checkout(state_dir, checkout, sha)
    write_build_record(owner, frozen_checkout_identity(checkout, sha))
    return checkout, disposition


@contextlib.contextmanager
def validation_worktree(
    sha: str, state_dir: pathlib.Path, lane: str
) -> Iterator[tuple[pathlib.Path, str, Optional[str]]]:
    rejected = None
    if lane == "preflight":
        try:
            checkout, disposition = prepare_frozen_preflight(sha, state_dir)
            lease = checkout.parent / "active"
            fd = os.open(lease, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            try:
                lease_identity = os.fstat(fd)
            finally:
                os.close(fd)
        except (CiError, OSError) as error:
            rejected = str(error)
        else:
            preserve_lease = False
            try:
                yield checkout, disposition, None
            except BaseException as error:
                preserve_lease = isinstance(error, GroupCleanupUnconfirmed) or isinstance(
                    error.__cause__, GroupCleanupUnconfirmed
                )
                raise
            finally:
                if not preserve_lease:
                    entry = lease.lstat()
                    if (entry.st_dev, entry.st_ino) != (lease_identity.st_dev, lease_identity.st_ino):
                        raise CiError("frozen checkout lease identity changed; preserved for inspection")
                    lease.unlink()
            return
    with exact_worktree(sha) as checkout:
        yield checkout, "temporary", rejected


def cargo_env(state_dir: pathlib.Path, channel: str, checkout: pathlib.Path) -> dict[str, str]:
    env = os.environ.copy()
    if env.get("RUSTFLAGS") or env.get("CARGO_ENCODED_RUSTFLAGS"):
        raise CiError("clear RUSTFLAGS and CARGO_ENCODED_RUSTFLAGS so the pinned channel feature set is reproducible")
    cache_lane = (
        "validation"
        if channel in {"check", "preflight", "full", "native"}
        else "release-local"
        if channel in {"beta", "release"}
        else channel
    )
    repository_root = state_dir.parent.parent
    shared_root = repository_root.parent / "yield-native-target" / cache_lane
    rust = command_output("rustc", "-vV", cwd=checkout).splitlines()
    identity = "-".join(line.split(": ", 1)[1] for line in rust if line.startswith(("release: ", "host: ")))
    lock_hash = hashlib.sha256((checkout / "Cargo.lock").read_bytes()).hexdigest()[:12]
    target = shared_root / f"{identity}-{lock_hash}"
    target.mkdir(parents=True, exist_ok=True)
    env["CARGO_TARGET_DIR"] = str(target)
    env["YIELD_VALIDATION_TARGET_ROOT"] = str(shared_root)
    env["CARGO_BUILD_JOBS"] = "2"
    env["CARGO_INCREMENTAL"] = "0"
    env["YIELD_GPUI_CI_CHECKOUT"] = str(checkout)
    return env


def doctor(lane: str) -> dict[str, str]:
    if platform.system() != "Darwin":
        raise CiError("local GPUI CI and native state operations are macOS-only")
    rust = command_output("rustc", "--version")
    if "1.93.0" not in rust:
        raise CiError(f"pinned Rust 1.93.0 required, found: {rust}")
    sdk = command_output("xcrun", "--show-sdk-version")
    sdk_path = pathlib.Path(command_output("xcrun", "--show-sdk-path"))
    if not sdk_path.is_dir():
        raise CiError(f"configured macOS SDK path is not a directory: {sdk_path}")
    clt = command_output("xcode-select", "-p")
    fs = filesystem_probe(pathlib.Path.home())
    if lane == "native" and (fs.get("filesystem", "").lower() != "apfs" or not fs.get("writable", False)):
        raise CiError("native lane requires a writable APFS home volume")
    return {
        "host": platform.platform(),
        "architecture": platform.machine(),
        "rust": rust,
        "cargo": command_output("cargo", "--version"),
        "sdk": sdk,
        "sdk_path": str(sdk_path),
        "command_line_tools": clt,
        "python": sys.version.split()[0],
        "filesystem_probe": json.dumps(fs, sort_keys=True),
        "disk_free_bytes": str(shutil.disk_usage(pathlib.Path.home()).free),
    }


def filesystem_probe(path: pathlib.Path) -> dict[str, object]:
    try:
        output = subprocess.check_output(["df", "-P", str(path)], text=True, stderr=subprocess.STDOUT)
        fields = output.splitlines()[-1].split()
        if len(fields) < 6:
            raise CiError("df returned an incomplete filesystem record")
        device = fields[0]
        plist = subprocess.check_output(["diskutil", "info", "-plist", device], stderr=subprocess.STDOUT)
        info = plistlib.loads(plist)
    except (OSError, subprocess.CalledProcessError, plistlib.InvalidFileException) as exc:
        raise CiError(f"cannot qualify the home filesystem with df and diskutil: {exc}") from exc
    filesystem = str(info.get("FilesystemType", info.get("FilesystemName", "unknown")))
    writable = info.get("WritableVolume")
    if not isinstance(writable, bool):
        writable = info.get("ReadOnlyVolume") is False
    return {"device": device, "mount": fields[-1], "filesystem": filesystem, "writable": bool(writable)}


def run_namespace_failure_aggregate(sha: str) -> None:
    failures: list[str] = []
    for case in (
        "prerequisite:startup-namespace-receive-failure",
        "prerequisite:startup-namespace-poll-failure",
    ):
        try:
            check(argparse.Namespace(sha=sha, lane="native", case=case))
        except CiError as error:
            failures.append(f"{case}: {error}")
    if failures:
        raise CiError(
            "startup-namespace-failure aggregate requires both independent native windows; "
            + "; ".join(failures)
        )


def _check(args: argparse.Namespace) -> None:
    sha = source_sha(args.sha)
    if args.lane == "native" and not args.case:
        raise CiError("native lane requires one exact allowlisted --case")
    if args.lane == "native" and args.case == "prerequisite:startup-namespace-failure":
        run_namespace_failure_aggregate(sha)
        return
    if args.lane == "native" and args.case == "audition-coreaudio":
        if os.environ.get("YIELD_TEST_AUDIO_OUTPUT") != "1":
            raise CiError(
                "audition-coreaudio requires inherited YIELD_TEST_AUDIO_OUTPUT=1; "
                "opt in explicitly before any clean-state preparation"
            )
    with (
        common_coordinator() as state_dir,
        validation_worktree(sha, state_dir, args.lane) as (checkout, disposition, cache_rejection),
    ):
        cached_identity = (
            frozen_checkout_identity(checkout, sha) if disposition != "temporary" else None
        )
        if args.lane in {"full", "native"}:
            require_maintenance_protocol(checkout, full_lane=args.lane == "full")
        env = cargo_env(state_dir, "check", checkout)
        if cached_identity is not None:
            env["PYTHONDONTWRITEBYTECODE"] = "1"
        if COORDINATOR_FD is not None:
            env["YIELD_LOCAL_CI_COORDINATOR_FD"] = str(COORDINATOR_FD)
        env["YIELD_LOCAL_CI_SOURCE_SHA"] = sha
        prepare_metadata_fixture = args.lane == "full" or (
            args.lane == "native" and args.case == "catalog-replay"
        )
        facts = doctor(args.lane)
        run_id = f"{time.time_ns()}-{os.getpid()}"
        out_dir = state_dir / "runs" / sha / args.lane / run_id
        out_dir.mkdir(parents=True)
        log_path = out_dir / (args.case.replace("::", "_") if args.case else "run")
        commands: list[list[str]] = []
        evidence_source = None
        retained_evidence = out_dir / "evidence"
        redirected_evidence = False
        if args.lane == "preflight":
            commands = [["bash", "scripts/agent.sh", "preflight"]]
        elif args.lane == "full":
            commands = [["bash", "scripts/agent.sh", "preflight"], ["bash", "scripts/gpui-local-ci.sh", "full"]]
        else:
            recording_cases = {
                "operation_journal::owner::recording_binding::tests::recording_custody_native_production_original_slot_currentness_and_drain",
                "operation_journal::owner::recording_binding::tests::recording_custody_native_production_lost_reply_keeps_original_slot_and_credit",
                "operation_journal::owner::recording_binding::tests::chunk_issuance_native_production_original_claim_transition_and_retained_backing",
            }
            prerequisite_cases = {
                "profile-generations",
                "source-release-policy",
                "startup-production",
                "startup-control-failure",
                "startup-namespace-failure",
                "startup-namespace-receive-failure",
                "startup-namespace-poll-failure",
                "sdk-and-startup-components",
            }
            if args.case not in recording_cases and args.case not in {"catalog-replay", "audition-coreaudio"}:
                prefix, separator, name = args.case.partition(":")
                if prefix != "prerequisite" or not separator or name not in prerequisite_cases:
                    raise CiError("native case is not in an existing exact-selector or named-runner allowlist")
            if os.environ.get("YIELD_CONFIG_HOME") or os.environ.get("YIELD_CONFIG_PROFILE"):
                raise CiError("clear YIELD_CONFIG_HOME and YIELD_CONFIG_PROFILE; native production acceptance requires the canonical namespace")
            if args.case in recording_cases:
                runner = checkout / "scripts/internal/validation/verify_recording_native_custody.sh"
                env["YIELD_NATIVE_CUSTODY_CASE"] = args.case
                evidence_source = checkout / "artifacts/recording-native-custody"
            elif args.case == "catalog-replay":
                runner = checkout / "scripts/internal/validation/verify_macos_catalog_native_replay.sh"
                evidence_source = checkout / "artifacts/macos-catalog-native-replay"
            elif args.case == "audition-coreaudio":
                runner = checkout / "scripts/internal/validation/verify_macos_audition_coreaudio.sh"
                evidence_source = checkout / "artifacts/macos-audition-coreaudio"
            else:
                _, _, prerequisite = args.case.partition(":")
                runner = checkout / "scripts/internal/validation/verify_native_prerequisites.sh"
                env["YIELD_NATIVE_PREREQUISITE_CASE"] = prerequisite
                evidence_source = checkout / "artifacts/native-prerequisites" / f"macos-{prerequisite}"
            if not runner.is_file():
                raise CiError(f"frozen source lacks the allowlisted native validation runner: {runner.relative_to(checkout)}")
            # Older exact commits still write their original in-checkout artifacts.
            redirect_marker = ("${" + NATIVE_EVIDENCE_OUTPUT + ":-").encode("ascii")
            redirected_evidence = redirect_marker in runner.read_bytes()
            if redirected_evidence:
                evidence_source = retained_evidence
                env[NATIVE_EVIDENCE_OUTPUT] = str(retained_evidence)
            else:
                env.pop(NATIVE_EVIDENCE_OUTPUT, None)
            commands = [["bash", str(runner)]]
        details = {"schema": 1, "run_id": run_id, "sha": sha, "lane": args.lane, "case": args.case, "platform": facts, "commands": commands, "results": []}
        details["checkout"] = {"path": str(checkout), "disposition": disposition}
        if cache_rejection is not None:
            details["checkout"]["cache_rejection"] = cache_rejection
        with log_path.with_suffix(".log").open("w", encoding="utf-8") as log:
            native_state = None
            namespace_fd = transition_fd = None
            validator_lease_fd = None
            failure = None
            try:
                if prepare_metadata_fixture:
                    fixture_command = [
                        sys.executable,
                        str(checkout / "scripts/internal/ci/prepare_native_metadata_fixture.py"),
                        "--checkout",
                        str(checkout),
                        "--state-dir",
                        str(state_dir),
                    ]
                    fixture_result = subprocess.run(
                        fixture_command, cwd=checkout, check=False, capture_output=True, text=True
                    )
                    if fixture_result.returncode != 0:
                        raise CiError(
                            "persistent native metadata fixture preparation failed: "
                            + fixture_result.stderr.strip()
                        )
                    try:
                        fixture_record = json.loads(fixture_result.stdout)
                    except json.JSONDecodeError as error:
                        raise CiError("native metadata fixture helper returned malformed evidence") from error
                    details["native_metadata_fixture"] = fixture_record
                    env["YIELD_NATIVE_METADATA_FIXTURE_ROOT"] = fixture_record["source_root"]
                    log.write("$ " + " ".join(fixture_command) + "\n")
                    log.write(json.dumps(fixture_record, sort_keys=True) + "\n")
                    log.flush()
                if args.lane == "native":
                    native_state, namespace_fd, transition_fd = local_state.prepare_clean_launch(
                        "production", artifact=f"native:{sha}:{args.case}"
                    )
                    details["production_state_transaction"] = native_state
                    env.pop("YIELD_MAINTENANCE_ADMISSION_FD", None)
                    env.pop("YIELD_MAINTENANCE_TRANSITION_FD", None)
                    validator_lease_fd = local_state.convert_clean_handoff_to_validator_lease(
                        "production", namespace_fd, transition_fd
                    )
                    if validator_lease_fd == namespace_fd:
                        namespace_fd = None
                    close_transition_fd = transition_fd
                    transition_fd = None
                    if close_transition_fd is not None:
                        os.close(close_transition_fd)
                    log.write("$ exclusive clean/production handoff\n")
                    log.write(json.dumps(native_state, sort_keys=True) + "\n")
                for cmd in commands:
                    log.write("$ " + " ".join(cmd) + "\n")
                    log.flush()
                    inherited_fds = [COORDINATOR_FD] if COORDINATOR_FD is not None else []
                    if validator_lease_fd is not None:
                        inherited_fds.append(validator_lease_fd)
                    pass_fds = tuple(inherited_fds)
                    exit_code = run_managed(
                        cmd,
                        cwd=checkout,
                        env=env,
                        stdout=log,
                        pass_fds=pass_fds,
                        preserve_ignored_on_exit=args.lane == "native",
                    )
                    details["results"].append({"command": cmd, "exit_code": exit_code})
                    if exit_code:
                        details["status"] = "failed"
                        break
                else:
                    details["status"] = "passed"
                if cached_identity is not None:
                    if frozen_checkout_identity(checkout, sha) != cached_identity:
                        raise CiError("frozen checkout filesystem identity changed during preflight")
                    verify_frozen_checkout(state_dir, checkout, sha)
                if evidence_source is not None and (
                    redirected_evidence or details.get("status") == "passed" or args.case == "audition-coreaudio"
                ):
                    if not evidence_source.is_dir() or evidence_source.is_symlink():
                        if details.get("status") == "passed":
                            raise CiError("native runner passed without retaining its expected evidence directory")
                    else:
                        if not redirected_evidence:
                            shutil.copytree(evidence_source, retained_evidence)
                        details["evidence_directory"] = str(retained_evidence)
            except BaseException as error:
                failure = error
                details["status"] = "failed"
                details["error"] = str(error)
                log.write(f"local CI runner error: {error}\n")
            finally:
                if native_state and native_state.get("transaction"):
                    # Process cleanup and state restoration form one signal-safe
                    # transaction, including ordinary child completion.
                    ignore_cancellation_signals()
                cleanup_errors = []
                descriptors = []
                seen_fds = set()
                for label, fd in (
                    ("validator lease", validator_lease_fd),
                    ("namespace", namespace_fd),
                    ("transition", transition_fd),
                ):
                    if fd is not None and fd not in seen_fds:
                        descriptors.append((label, fd))
                        seen_fds.add(fd)
                validator_lease_fd = namespace_fd = transition_fd = None
                for label, fd in descriptors:
                    try:
                        os.close(fd)
                    except BaseException as error:
                        cleanup_errors.append({"descriptor": label, "error": str(error)})
                        if failure is None:
                            failure = error
                        try:
                            log.write(f"{label} descriptor cleanup error: {error}\n")
                            log.flush()
                        except BaseException:
                            pass
                if native_state and native_state.get("transaction"):
                    if isinstance(failure, GroupCleanupUnconfirmed):
                        details["status"] = "restore_deferred"
                        details["restore_error"] = (
                            "validator process-group exit was not confirmed; "
                            f"production state remains parked in {native_state['transaction']}"
                        )
                        log.write(f"state restore deferred: {details['restore_error']}\n")
                        log.flush()
                    else:
                        try:
                            restored = local_state.restore(str(native_state["transaction"]))
                            details["production_state_restore"] = restored
                        except BaseException as error:
                            details["status"] = "restore_failed"
                            details["restore_error"] = str(error)
                            if failure is None:
                                failure = error
                            try:
                                log.write(f"state restore error: {error}\n")
                                log.flush()
                            except BaseException:
                                pass
                if cleanup_errors:
                    details["descriptor_cleanup_errors"] = cleanup_errors
                    if details.get("status") == "passed":
                        details["status"] = "cleanup_failed"
        if redirected_evidence and "evidence_directory" not in details:
            try:
                if retained_evidence.is_dir() and not retained_evidence.is_symlink():
                    details["evidence_directory"] = str(retained_evidence)
            except OSError as error:
                details["evidence_inspection_error"] = str(error)
        details["completed_unix_ns"] = time.time_ns()
        log_path.with_suffix(".json").write_text(json.dumps(details, indent=2) + "\n", encoding="utf-8")
        print(json.dumps(details, indent=2))
        if isinstance(failure, KeyboardInterrupt):
            raise failure
        if failure is not None:
            raise CiError(f"validation operation failed: {failure}") from failure
        if details["status"] != "passed":
            raise CiError(f"{args.lane} lane failed; complete log retained at {log_path.with_suffix('.log')}")


def check(args: argparse.Namespace) -> None:
    # Keep original signal handlers until _check has closed descriptors and
    # finished restoring any parked native production state.
    with catch_cancellation_signals():
        return _check(args)


def build(args: argparse.Namespace) -> None:
    sha = source_sha(args.sha)
    with common_coordinator() as state_dir:
        run_id = f"{time.time_ns()}-{os.getpid()}-{uuid.uuid4().hex[:12]}"
        run_dir = state_dir / "runs" / sha / f"build-{args.channel}" / run_id
        run_dir.mkdir(parents=True, mode=0o700)
        log_path = run_dir / "build.log"
        record_path = run_dir / "result.json"
        record: dict[str, object] = {
            "schema": 1,
            "run_id": run_id,
            "source_sha": sha,
            "lane": f"build-{args.channel}",
            "channel": args.channel,
            "status": "running",
            "phase": "setup",
            "commands": [],
            "log": str(log_path),
            "started_unix_ns": time.time_ns(),
        }
        write_build_record(record_path, record)
        artifact_dir = ROOT / "artifacts" / "local-ci" / sha / args.channel / run_id
        artifact_published = False
        active_phase = "setup"
        active_command: Optional[list[str]] = None
        with log_path.open("w", encoding="utf-8") as log:
            log.write(f"build run {run_id} source={sha} channel={args.channel}\n")
            log.flush()
            try:
                with exact_worktree(sha) as checkout:
                    active_phase = "source-validation"
                    record["phase"] = active_phase
                    write_build_record(record_path, record)
                    require_maintenance_protocol(checkout)
                    facts = doctor("build")
                    env = cargo_env(state_dir, args.channel, checkout)
                    if COORDINATOR_FD is not None:
                        env["YIELD_LOCAL_CI_COORDINATOR_FD"] = str(COORDINATOR_FD)
                    if args.channel == "test":
                        command = ["cargo", "build", "--locked", "-p", "yield", "--features", "development-state"]
                        binary = pathlib.Path(env["CARGO_TARGET_DIR"]) / "debug" / "yield"
                        namespace = ".yield-development"
                    else:
                        command = ["cargo", "build", "--locked", "--profile", "release-local", "-p", "yield"]
                        binary = pathlib.Path(env["CARGO_TARGET_DIR"]) / "release-local" / "yield"
                        namespace = ".yield"
                    pass_fds = (COORDINATOR_FD,) if COORDINATOR_FD is not None else ()

                    active_phase = "cargo-build"
                    active_command = command
                    record["phase"] = active_phase
                    record["commands"].append({"phase": active_phase, "command": command, "status": "running"})
                    write_build_record(record_path, record)
                    log.write("$ " + " ".join(command) + "\n")
                    log.flush()
                    try:
                        exit_code = run_managed(command, cwd=checkout, env=env, pass_fds=pass_fds, stdout=log)
                    except BaseException:
                        record["commands"][-1]["status"] = "interrupted"
                        raise
                    record["commands"][-1].update({"status": "completed", "exit_code": exit_code})
                    record["commands"][-1]["result_unix_ns"] = time.time_ns()
                    write_build_record(record_path, record)
                    active_command = None
                    if exit_code:
                        raise CiError(f"build failed with exit {exit_code}")
                    if not binary.is_file():
                        raise CiError(f"build did not produce expected executable: {binary}")

                    active_phase = "build-info"
                    record["phase"] = active_phase
                    write_build_record(record_path, record)
                    try:
                        build_info = compiled_build_info(binary)
                    except CiError as exc:
                        raise CiError("built executable did not return valid pre-admission build-info") from exc
                    log.write("compiled build-info: " + json.dumps(build_info, sort_keys=True) + "\n")
                    expected_namespace = ".yield-development" if args.channel == "test" else ".yield"
                    if (
                        build_info.get("protocol") != 1
                        or build_info.get("namespace") != expected_namespace
                        or not isinstance(build_info.get("package_version"), str)
                        or build_info.get("admission_marker") != ADMISSION_MARKER.decode("ascii")
                    ):
                        raise CiError("compiled build-info does not match the pinned channel/admission protocol")

                    active_phase = "packaging"
                    record["phase"] = active_phase
                    write_build_record(record_path, record)
                    artifact_dir.parent.mkdir(parents=True, exist_ok=True)
                    icon = checkout / "assets/logo3.icns"
                    font_license = checkout / "assets/fonts/IoskeleyMono-LICENSE.txt"
                    for required in (icon, font_license):
                        if not required.is_file():
                            raise CiError(f"missing macOS bundle asset: {required}")
                    metadata = json.loads(command_output(
                        "cargo", "metadata", "--locked", "--no-deps", "--format-version", "1",
                        cwd=checkout, log=log
                    ))
                    package_version = next(p["version"] for p in metadata["packages"] if p["name"] == "yield")
                    bundle_version = command_output("git", "rev-list", "--count", sha, cwd=checkout, log=log)
                    binary_relative = "Yield.app/Contents/MacOS/yield"
                    with tempfile.TemporaryDirectory(prefix=".yield-local-ci-package-", dir=artifact_dir.parent) as temporary:
                        staged = pathlib.Path(temporary) / "artifact"
                        app_bundle = staged / "Yield.app"
                        staged_binary = app_bundle / "Contents/MacOS/yield"
                        info = {
                            "CFBundleExecutable": "yield",
                            "CFBundleIdentifier": {
                                "test": "org.portalsurfer.yield.test",
                                "beta": "org.portalsurfer.yield.beta",
                                "release": "org.portalsurfer.yield",
                            }[args.channel],
                            "CFBundleName": "Yield",
                            "CFBundleDisplayName": "Yield",
                            "CFBundleIconFile": "Yield.icns",
                            "CFBundlePackageType": "APPL",
                            "CFBundleShortVersionString": package_version,
                            "CFBundleVersion": bundle_version,
                            "NSHighResolutionCapable": True,
                            "YieldSourceCommit": sha,
                            "YieldMaintenanceNamespace": namespace,
                            "YieldMaintenanceProtocol": 1,
                            "YieldChannel": args.channel,
                        }
                        signature_details = _packager.create_signed_bundle(
                            binary, app_bundle, icon, font_license, info, cwd=checkout, log=log
                        )
                        log.write("ad-hoc signature verified\n")
                        files = sorted(path for path in (staged / "Yield.app").rglob("*") if path.is_file())
                        file_records = [
                            {"path": str(path.relative_to(staged)), "size": path.stat().st_size,
                             "sha256": sha256_file(path)}
                            for path in files
                        ]
                        manifest = {
                            "schema": 1, "source_sha": sha, "run_id": run_id, "dirty": False,
                            "channel": args.channel, "compiled_namespace": namespace,
                            "build_info": build_info, "package_version": package_version,
                            "bundle_version": bundle_version, "bundle_identifier": info["CFBundleIdentifier"],
                            "signature_mode": "adhoc", "host": facts,
                            "toolchain": command_output("rustc", "-Vv", cwd=checkout, log=log),
                            "command": command, "exit_code": 0, "binary": binary_relative,
                            "binary_sha256": sha256_file(staged_binary),
                            "artifact_identity": {"device": staged_binary.stat().st_dev, "inode": staged_binary.stat().st_ino},
                            "files": file_records, "created_unix_ns": time.time_ns(),
                        }
                        (staged / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
                        if artifact_dir.exists():
                            raise CiError(f"artifact directory already exists: {artifact_dir}")
                        os.rename(staged, artifact_dir)
                        artifact_published = True
                    manifest_path = artifact_dir / "manifest.json"
                    record.update({
                        "status": "passed", "phase": "complete", "completed_unix_ns": time.time_ns(),
                        "artifact_manifest": str(manifest_path),
                    })
                    write_build_record(record_path, record)
                    print(manifest_path)
            except BaseException as error:
                log.write(f"build {active_phase} failed: {type(error).__name__}: {error}\n")
                log.flush()
                if active_command is not None:
                    record["commands"][-1].update({"status": "interrupted", "error": str(error)})
                command_error = error
                if isinstance(command_error, CiError) and isinstance(command_error.__cause__, subprocess.CalledProcessError):
                    command_error = command_error.__cause__
                if isinstance(command_error, subprocess.CalledProcessError):
                    record["failed_command"] = list(command_error.cmd) if isinstance(command_error.cmd, (list, tuple)) else str(command_error.cmd)
                    record["exit_code"] = command_error.returncode
                status = "cancelled" if isinstance(error, KeyboardInterrupt) or "cancelled" in str(error).lower() else "failed"
                record.update({
                    "status": status, "phase": active_phase, "error": f"{type(error).__name__}: {error}",
                    "completed_unix_ns": time.time_ns(),
                })
                try:
                    write_build_record(record_path, record)
                except OSError as record_error:
                    log.write(f"failed to persist final run record: {record_error}\n")
                    log.flush()
                if artifact_published:
                    rejected = run_dir / "rejected-artifact"
                    if not rejected.exists():
                        os.rename(artifact_dir, rejected)
                if isinstance(error, KeyboardInterrupt):
                    raise
                if isinstance(error, CiError):
                    raise CiError(
                        f"build failed during {active_phase}; run evidence retained at {run_dir}: {error}"
                    ) from error
                raise CiError(f"build failed during {active_phase}; run evidence retained at {run_dir}") from error


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def run_artifact(args: argparse.Namespace) -> None:
    inherited = os.environ.copy()
    if inherited.get("YIELD_CONFIG_HOME") or inherited.get("YIELD_CONFIG_PROFILE"):
        raise CiError("remove YIELD_CONFIG_HOME and YIELD_CONFIG_PROFILE; managed launch uses the canonical channel namespace")
    manifest_path = pathlib.Path(args.artifact).expanduser().resolve()
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("schema") != 1 or not isinstance(manifest.get("binary"), str):
        raise CiError("artifact manifest has an unsupported shape")
    expected_bundle_id = {
        "test": "org.portalsurfer.yield.test",
        "beta": "org.portalsurfer.yield.beta",
        "release": "org.portalsurfer.yield",
    }.get(manifest.get("channel"))
    if manifest.get("bundle_identifier") != expected_bundle_id:
        raise CiError("artifact channel and bundle identifier disagree")
    if manifest.get("signature_mode") != "adhoc":
        raise CiError("artifact manifest does not identify a local ad-hoc signature")
    binary_relative = pathlib.PurePosixPath(manifest["binary"])
    if binary_relative.is_absolute() or ".." in binary_relative.parts:
        raise CiError("artifact executable path escapes its bundle")
    binary_entry = manifest_path.parent.joinpath(*binary_relative.parts)
    cursor = manifest_path.parent
    for component in binary_relative.parts:
        cursor = cursor / component
        if cursor.is_symlink():
            raise CiError("artifact bundle contains a linked executable path")
    if not binary_entry.is_file() or binary_entry.stat().st_uid != os.geteuid():
        raise CiError("artifact executable must be a regular current-user-owned file")
    binary = binary_entry.resolve()
    if sha256_file(binary) != manifest.get("binary_sha256"):
        raise CiError("artifact manifest or executable checksum is invalid")
    identity = manifest.get("artifact_identity")
    binary_metadata = binary.stat()
    if not isinstance(identity, dict) or identity.get("device") != binary_metadata.st_dev or identity.get("inode") != binary_metadata.st_ino:
        raise CiError("artifact executable identity differs from its build manifest")
    files = manifest.get("files")
    if not isinstance(files, list) or not files:
        raise CiError("artifact manifest does not inventory bundle files")
    for item in files:
        if not isinstance(item, dict):
            raise CiError("artifact file inventory is malformed")
        relative = pathlib.PurePosixPath(item.get("path", ""))
        if relative.is_absolute() or ".." in relative.parts:
            raise CiError("artifact manifest contains a path outside the bundle")
        entry = manifest_path.parent.joinpath(*relative.parts)
        cursor = manifest_path.parent
        for component in relative.parts:
            cursor = cursor / component
            if cursor.is_symlink():
                raise CiError("artifact bundle contains a linked file path")
        if not entry.is_file() or entry.stat().st_size != item.get("size") or sha256_file(entry) != item.get("sha256"):
            raise CiError(f"artifact file does not match its manifest: {relative}")
    app_bundle = manifest_path.parent / "Yield.app"
    try:
        command_output("codesign", "--verify", "--strict", "--deep", str(app_bundle))
        signature_details = command_output(
            "codesign", "--display", "--verbose=4", str(app_bundle), combined_output=True
        )
        info = plistlib.loads((app_bundle / "Contents/Info.plist").read_bytes())
    except (CiError, OSError, plistlib.InvalidFileException) as exc:
        raise CiError("artifact bundle signature or Info.plist is invalid") from exc
    if (
        "Signature=adhoc" not in signature_details
        or info.get("CFBundleIdentifier") != expected_bundle_id
        or info.get("YieldChannel") != manifest.get("channel")
        or info.get("YieldSourceCommit") != manifest.get("source_sha")
        or info.get("YieldMaintenanceNamespace") != manifest.get("compiled_namespace")
        or info.get("YieldMaintenanceProtocol") != 1
    ):
        raise CiError("signed bundle metadata does not match its channel manifest")
    if not re_full_sha(manifest.get("source_sha")) or manifest.get("dirty") is not False:
        raise CiError("artifact lacks exact clean-source provenance")
    if manifest.get("compiled_namespace") != (".yield-development" if manifest.get("channel") == "test" else ".yield"):
        raise CiError("artifact channel and compiled namespace disagree")
    build_info = manifest.get("build_info")
    if (
        not isinstance(build_info, dict)
        or build_info.get("protocol") != 1
        or build_info.get("namespace") != manifest.get("compiled_namespace")
        or build_info.get("package_version") != manifest.get("package_version")
        or build_info.get("admission_marker") != ADMISSION_MARKER.decode("ascii")
    ):
        raise CiError("artifact lacks verified compiled maintenance-protocol provenance")
    try:
        actual_build_info = compiled_build_info(binary)
    except CiError as exc:
        raise CiError("artifact executable does not report valid pre-admission build-info") from exc
    if (
        actual_build_info.get("protocol") != build_info.get("protocol")
        or actual_build_info.get("namespace") != build_info.get("namespace")
        or actual_build_info.get("package_version") != build_info.get("package_version")
        or actual_build_info.get("admission_marker") != build_info.get("admission_marker")
    ):
        raise CiError("artifact's compiled build-info differs from its manifest")
    namespace = "development" if manifest["compiled_namespace"] == ".yield-development" else "production"
    if args.state == "clean":
        result, namespace_fd, transition_fd = local_state.prepare_clean_launch(namespace, artifact=str(manifest_path))
        print(json.dumps(result, indent=2), flush=True)
        env = inherited
        env.pop("YIELD_MAINTENANCE_ADMISSION_FD", None)
        env.pop("YIELD_MAINTENANCE_TRANSITION_FD", None)
        env["YIELD_MAINTENANCE_ADMISSION_FD"] = str(namespace_fd)
        env["YIELD_MAINTENANCE_TRANSITION_FD"] = str(transition_fd)
        try:
            exit_code = run_managed(
                [str(binary)], cwd=ROOT, env=env, pass_fds=(namespace_fd, transition_fd)
            )
        finally:
            os.close(namespace_fd)
            os.close(transition_fd)
        if exit_code:
            raise CiError(f"Yield exited with status {exit_code}")
    else:
        _, control = local_state.namespace_paths(namespace)
        with local_state.maintenance_locks(control, namespace, exclusive=False):
            env = inherited
            env.pop("YIELD_MAINTENANCE_ADMISSION_FD", None)
            env.pop("YIELD_MAINTENANCE_TRANSITION_FD", None)
            exit_code = run_managed([str(binary)], cwd=ROOT, env=env)
        if exit_code:
            raise CiError(f"Yield exited with status {exit_code}")


def re_full_sha(value: object) -> bool:
    return isinstance(value, str) and len(value) == 40 and all(character in "0123456789abcdef" for character in value)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="operation", required=True)
    sub.add_parser("doctor").add_argument("--lane", choices=("preflight", "full", "native", "build"), default="preflight")
    check_cmd = sub.add_parser("check")
    check_cmd.add_argument("--sha", required=True)
    check_cmd.add_argument("--lane", choices=("preflight", "full", "native"), required=True)
    check_cmd.add_argument("--case")
    build_cmd = sub.add_parser("build")
    build_cmd.add_argument("--sha", required=True)
    build_cmd.add_argument("--channel", choices=("test", "beta", "release"), required=True)
    run_cmd = sub.add_parser("run")
    run_cmd.add_argument("--artifact", required=True)
    run_cmd.add_argument("--state", choices=("normal", "clean"), required=True)
    state = sub.add_parser("state")
    state_sub = state.add_subparsers(dest="state_action", required=True)
    status_cmd = state_sub.add_parser("status")
    status_cmd.add_argument("--namespace", choices=("development", "production"), required=True)
    clean_cmd = state_sub.add_parser("clean")
    clean_cmd.add_argument("--namespace", choices=("development", "production"), required=True)
    reset_cmd = state_sub.add_parser(
        "reset", help="start fresh normal state, retaining the entire old state as a backup"
    )
    reset_cmd.add_argument("--namespace", choices=("development", "production"), required=True)
    restore_cmd = state_sub.add_parser("restore")
    restore_cmd.add_argument("--backup", required=True)
    recover_cmd = state_sub.add_parser("recover")
    recover_cmd.add_argument("--transaction", required=True)
    archive_cmd = state_sub.add_parser("archive", help="retain a superseded reset backup as historical evidence")
    archive_cmd.add_argument("--transaction", required=True)
    archive_cmd.add_argument("--reason", required=True)
    args = parser.parse_args()
    try:
        if args.operation == "doctor":
            print(json.dumps(doctor(args.lane), indent=2))
        elif args.operation == "check":
            check(args)
        elif args.operation == "build":
            build(args)
        elif args.operation == "run":
            run_artifact(args)
        elif args.operation == "state":
            action = args.state_action
            if action == "status":
                result = local_state.status(args.namespace)
            elif action in {"clean", "reset"}:
                result = local_state.clean(args.namespace)
                if action == "reset":
                    result["next_step"] = "Launch normally to create fresh state; subsequent normal launches retain it."
                    result["restore_note"] = (
                        "The backup retains all prior state and recovery evidence. Restoring it also restores any prior startup fault."
                        if result.get("transaction")
                        else "No prior state was present; no backup was created."
                    )
            elif action == "restore":
                result = local_state.restore(args.backup)
            elif action == "archive":
                result = local_state.archive(args.transaction, args.reason)
            else:
                result = local_state.recover(args.transaction)
            print(json.dumps(result, indent=2))
        return 0
    except (CiError, local_state.StateError, OSError, subprocess.SubprocessError) as exc:
        print(f"yield-local-ci: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
