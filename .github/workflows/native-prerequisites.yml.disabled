name: Native source and profile prerequisites
on:
  workflow_dispatch:
  pull_request:
    branches: [main]
    paths:
      - '.github/workflows/native-prerequisites.yml'
      - 'scripts/internal/validation/verify_native_prerequisites.sh'
permissions:
  contents: read
concurrency:
  group: native-prerequisites-${{ github.ref }}
  cancel-in-progress: true
jobs:
  native-prerequisite:
    name: ${{ matrix.runner }} / ${{ matrix.case }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: macos-15-intel
            case: profile-generations
          - runner: windows-2025
            case: profile-generations
          - runner: macos-15-intel
            case: source-release-policy
          - runner: windows-2025
            case: source-release-policy
          - runner: macos-15-intel
            case: startup-production
          - runner: macos-15-intel
            case: startup-control-failure
          - runner: macos-15-intel
            case: startup-namespace-failure
          - runner: macos-15-intel
            case: sdk-and-startup-components
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 45
    defaults:
      run:
        shell: bash
    env:
      YIELD_NATIVE_PREREQUISITE_CASE: ${{ matrix.case }}
      CARGO_BUILD_JOBS: '2'
      CARGO_INCREMENTAL: '0'
      CARGO_PROFILE_DEV_DEBUG: '0'
      CARGO_PROFILE_TEST_DEBUG: '0'
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
      - name: Install repository-pinned native Rust toolchain
        run: rustup show active-toolchain
      - name: Reuse pinned native build dependencies
        id: native-cache
        uses: actions/cache@5a3ec84eff668545956fd18022155c47e93e2684 # v4.2.3
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: native-prerequisites-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('rust-toolchain.toml', 'Cargo.lock') }}-${{ matrix.case }}-${{ github.event.pull_request.head.sha || github.sha }}
          restore-keys: |
            native-prerequisites-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('rust-toolchain.toml', 'Cargo.lock') }}-
            recording-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('rust-toolchain.toml', 'Cargo.lock') }}-
      - name: Execute complete original native case
        run: bash scripts/internal/validation/verify_native_prerequisites.sh
      - name: Preserve native resource, command and result evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: native-${{ runner.os }}-${{ matrix.case }}-${{ github.event.pull_request.head.sha || github.sha }}
          path: artifacts/native-prerequisites/
          if-no-files-found: warn
          retention-days: 14
      - name: Preserve build cache after a failed native case
        if: failure() && steps.native-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@5a3ec84eff668545956fd18022155c47e93e2684 # v4.2.3
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: native-prerequisites-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('rust-toolchain.toml', 'Cargo.lock') }}-${{ matrix.case }}-${{ github.event.pull_request.head.sha || github.sha }}
